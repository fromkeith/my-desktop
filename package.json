{
  "name": "@my-desktop/root",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "postinstall": "turbo run deps:go",
    "docker:up": "docker-compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.yml down",
    "db:migrate:postgres": "dbmate -d packages/server-shared/migrations -u \"postgres://postgres:postgres@localhost:5432/desktop?sslmode=disable\" up",
    "db:migrate:mongo": "cd packages/server-shared/migrations/mongo && migrate-mongo up",
    "db:migrate": "pnpm db:migrate:postgres && pnpm db:migrate:mongo",
    "db:migrate:mongo:create": "cd packages/server-shared/migrations/mongo && migrate-mongo create",
    "db:migrate:mongo:down": "cd packages/server-shared/migrations/mongo && migrate-mongo down"
  },
  "devDependencies": {
    "cross-env": "latest",
    "migrate-mongo": "^11.0.0",
    "turbo": "latest",
    "prettier": "latest"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
